# ─────────────────────────────────────────────────────────────────────────────
# OPL Crew Mono — Environment Variables
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Release Version ──────────────────────────────────────────────────────
# Image tag for backend + frontend. compose.yml defaults to "latest".
# Pin a release when needed, e.g. APP_VERSION=v2.4.0
APP_VERSION=latest

# ── LLM / Red Hat MaaS (Required) ────────────────────────────────────────
LLM_API_KEY=
LLM_API_BASE_URL=https://litellm-prod.apps.maas.redhatworkshops.io
# Per-agent models (installer.sh prompts for these; also written to config.yaml)
LLM_MODEL_MANAGER=deepseek-r1-distill-qwen-14b
LLM_MODEL_WORKER=qwen3-14b
LLM_MODEL_REVIEWER=qwen3-14b

# ── Backend Config ────────────────────────────────────────────────────────
# Path to LLM config.yaml mounted into the backend (relative to compose.yml).
# The installer writes ./config.yaml next to compose.yml — keep this in sync.
# Do NOT point at a missing path: compose will create an empty directory there.
CONFIG_FILE=./config.yaml
FLASK_ENV=production

# Tech-stack file manifest guard for file_writer + validation (backend)
# strict  — only registered tech_stack paths during remediation; strict file_manifest check
# relaxed — allow companion tests + on-disk sources during remediation (default)
# off     — no write-time allowlist during remediation; skip file_manifest validation
TECH_STACK_MANIFEST_GUARD=relaxed

# Parallel file-generation workers per lane (backend / frontend dev phases).
# Overrides generation.parallel_file_workers in config.yaml when set.
# Omit (or leave empty) to use the value from config.yaml (default: 3).
# Set to 1 for sequential / debug mode; 3-4 for typical MaaS endpoints.
# PARALLEL_FILE_WORKERS=3

# ── CORS (split frontend deployment) ─────────────────────────────────────
# Comma-separated list of allowed origins for cross-origin requests.
# compose.yml defaults to http://localhost:3100 (community stack frontend).
# CORS_ALLOWED_ORIGINS=http://localhost:3100,http://127.0.0.1:3100
# ── Dev Compose profiles (dev-compose.yml) ───────────────────────────────
# Services without a profile: validator, backend, frontend.
# Uncomment to always start optional stacks with plain `podman compose up -d`:
# COMPOSE_PROFILES=skills,jira

# ── Ports (community compose.yml defaults — uncomment to override) ───────
# FRONTEND_PORT=3100
# BACKEND_PORT=8280
# VALIDATOR_PORT=8281
# KEYCLOAK_PORT=8380
# Issuer/authority must match KEYCLOAK_PORT (browser reaches Keycloak on this host port):
# KEYCLOAK_ISSUER_URL=http://localhost:8380/realms/opl-crew
# VITE_OIDC_AUTHORITY=http://localhost:8380/realms/opl-crew
# JIRA_PORT=8081
# CONNECTOR_PORT=8082

# ── Code Validator ────────────────────────────────────────────────────────
VALIDATOR_LOG_LEVEL=INFO

# ── Jira Connector ───────────────────────────────────────────────────────
JIRA_BACKEND=rest
JIRA_BASE_URL=http://jira:8080
JIRA_EMAIL=
JIRA_API_TOKEN=
# JIRA_USERNAME=
# JIRA_PASSWORD=
# JIRA_PERSONAL_ACCESS_TOKEN=
# JIRA_PROJECT_KEYS=PROJ,DEMO
# JIRA_TRIGGER_STATUS=Ready for Dev
# JIRA_WEBHOOK_SECRET=

# ── Skills Service ──────────────────────────────────────────────────────
# Path to skills-service (Git submodule at mono repo root: ./skills-service).
# Dev compose runs from opl_ai_mono root; default is ./skills-service.
SKILLS_SERVICE_DIR=./skills-service
# Backend proxy URL — use local container in dev (skills profile); remote MCP only for prod override
# SKILLS_SERVICE_URL=http://skills-service:8090
# SKILLS_DIR=./skills
# FRAPPE_SKILLS_DIR=../1frappe_ecosystem/frappe-apps-manager/.cursor/skills
# Sandbox API usage/security skills, so agents can discover how to run code safely
# SANDBOX_SKILLS_DIR=../podman-sandbox-api2/skills
# SKILLS_PORT=8090

# ── Sandbox API (runtime code execution) ──
# The Sandbox API runs on the host and drives podman directly; the backend
# reaches it via host.docker.internal. Set SMOKE_TEST_BACKEND=sandbox_api to
# execute generated code during validation instead of static analysis only.
# SANDBOX_API_URL=http://host.docker.internal:18080
# SMOKE_TEST_BACKEND=sandbox_api

# ── GitHub integration (PR creation after import & iterate refinements) ──
# Personal access token with repo + pull_request scopes
# GITHUB_TOKEN=ghp_your_token_here
# Git commit author identity used when pushing refined code
# GITHUB_USER_NAME=Your Name
# GITHUB_USER_EMAIL=you@example.com

# ── Ollama (optional, for local models instead of MaaS) ──────────────────
# OLLAMA_BASE_URL=http://ollama:11434

# ── Keycloak / Auth ──────────────────────────────────────────────────────
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=8180
AUTH_ENABLED=true
# Set false for passwordless demo (installer.sh sets this automatically)
# VITE_AUTH_ENABLED=false

# ─────────────────────────────────────────────────────────────────────────
# Context Memory Plane (MemMachine) — the P3 historical knowledge plane
# ─────────────────────────────────────────────────────────────────────────
# Job outcomes, Jira issue context, and reference-doc summaries are written at
# lifecycle hooks and recalled at the start of solutioning, so a new job starts
# with what past jobs on the same stack/domain learned.
#
# Start the stack (3 containers, opt-in profile):
#   podman compose -f dev-compose.yml --profile memory up -d
#
# Then flip this on. Fail-open by design: with MEMORY_ENABLED=false or the
# stack down, jobs run exactly as they do today.
# MEMORY_ENABLED=true

# Backend → MemMachine. Container-internal default already set in dev-compose.
# MEMMACHINE_BASE_URL=http://memmachine-app:8080
# MEMMACHINE_API_KEY=

# Host port for the MemMachine API. Default 8280 — 8080 is the backend and
# 8180 is Keycloak, so the upstream MemMachine default would collide.
# MEMMACHINE_PORT=8280
# MEMMACHINE_POSTGRES_PORT=55432
# MEMMACHINE_NEO4J_HTTP_PORT=7474
# MEMMACHINE_NEO4J_BOLT_PORT=7687

# Change these before any shared/non-local deployment.
# MEMMACHINE_POSTGRES_PASSWORD=memmachine_password
# MEMMACHINE_NEO4J_PASSWORD=neo4j_password

# MemMachine runs its own embedder + LLM (separate from the OPL agents) for
# semantic indexing. It needs a working /v1/embeddings endpoint — NOT every
# OpenAI-compatible gateway provides one, and the MaaS LiteLLM proxy used for
# chat may not. If embedding calls 404, point these at a gateway that serves
# embeddings (or Ollama with nomic-embed-text); the OPL agents are unaffected.
# Defaults to LLM_API_KEY / LLM_API_BASE_URL when unset.
# MEMMACHINE_LLM_API_KEY=
# MEMMACHINE_LLM_BASE_URL=https://api.openai.com/v1
# MEMMACHINE_LLM_MODEL=gpt-4o-mini
# MEMMACHINE_EMBED_MODEL=text-embedding-3-small
# MEMMACHINE_EMBED_DIMENSIONS=1536

# Tuning (all optional; env wins over config.yaml)
# MEMORY_SEARCH_LIMIT=5
# MEMORY_MAX_RECALL_CHARS=4000
# MEMORY_TIMEOUT_SECONDS=15
# MEMORY_DEFAULT_ORG_ID=default
# MEMORY_SHARED_PROJECT_ID=shared-context
# Which LLM tier writes summaries: manager|worker|reviewer|none.
# Summaries are 2-3 sentence calls — keep them on your cheapest model.
# MEMORY_SUMMARY_AGENT_TYPE=reviewer

# ─────────────────────────────────────────────────────────────────────────
# headroom token-compression proxy (Phase 1)
# ─────────────────────────────────────────────────────────────────────────
# An OpenAI-compatible proxy in front of your LLM endpoint that compresses
# request context. Vendor-reported savings: 60-95% on JSON-heavy payloads,
# 15-20% on coding-agent workloads — expect the lower band here.
#
#   podman compose -f dev-compose.yml --profile headroom up -d
#
# Point the agents at the proxy and tell the proxy the real upstream:
# LLM_API_BASE_URL=http://headroom:8787/v1
# HEADROOM_UPSTREAM_URL=https://litellm-prod.apps.maas.redhatworkshops.io/v1
#
# LIMITATION — BYOK bypasses the proxy. Per-user base URLs from the Settings UI
# (user_llm_configs) are used verbatim, so those calls go straight to the user's
# provider. Only the server-default endpoint is compressed.
#
# cache = freeze prior turns for max provider prefix-cache hits (default)
# token = rewrite prior turns for maximum compression
# HEADROOM_MODE=cache
# HEADROOM_PORT=8787

# Corrections — what humans and verifiers had to fix, stored verbatim.
# Spans every job mode (build/import/refine/migration/refactor), no LLM cost.
# This is the highest-signal recall the plane produces; corrections are sorted
# to the front of the injected context block so truncation never drops them.
# Set false if a customer forbids storing reviewer wording.
# MEMORY_WRITE_CORRECTIONS=true
# MEMORY_MAX_CORRECTIONS=25
